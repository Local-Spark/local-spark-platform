LOCAL_SPARK_ENVIRONMENT=development
LOCAL_SPARK_DATABASE_URL=postgresql+asyncpg://local_spark_runtime:local-spark-app-password@localhost:55432/local_spark_platform
LOCAL_SPARK_RELAY_DATABASE_URL=postgresql+asyncpg://local_spark_delivery:local-spark-relay-password@localhost:55432/local_spark_platform
LOCAL_SPARK_MIGRATION_DATABASE_URL=postgresql+asyncpg://postgres:local-spark-admin-password@localhost:55432/local_spark_platform
LOCAL_SPARK_JWT_SECRET=development-local-spark-change-this-secret-before-deploying
LOCAL_SPARK_JWT_ISSUER=local-spark-local
LOCAL_SPARK_JWT_AUDIENCE=local-spark-api
LOCAL_SPARK_TEMPORAL_ADDRESS=localhost:7233
LOCAL_SPARK_TEMPORAL_NAMESPACE=default
LOCAL_SPARK_TEMPORAL_TASK_QUEUE=local-spark-foundation

LOCAL_SPARK_AUTH_DATABASE_URL=postgresql+asyncpg://local_spark_identity:local-spark-auth-password@localhost:55432/local_spark_platform
LOCAL_SPARK_PUBLIC_WEB_URL=http://localhost:5173
LOCAL_SPARK_AUTH_ENCRYPTION_KEY=MDAwMDAwMDAwMDAwMDAwMDAwMDAwMDAwMDAwMDAwMDA=
LOCAL_SPARK_SMTP_HOST=localhost
LOCAL_SPARK_SMTP_PORT=11025
LOCAL_SPARK_BILLING_DATABASE_URL=postgresql+asyncpg://local_spark_payments:local-spark-billing-password@localhost:55432/local_spark_platform
LOCAL_SPARK_BILLING_MODE=disabled
LOCAL_SPARK_PHONE_VERIFY_MODE=disabled
# Enable only after creating a Twilio Verify Service and API key in your account.
# LOCAL_SPARK_PHONE_VERIFY_MODE=twilio
# LOCAL_SPARK_PHONE_VERIFY_CHANNEL=sms
# LOCAL_SPARK_TWILIO_VERIFY_SERVICE_SID=VA...
# LOCAL_SPARK_TWILIO_API_KEY=SK...
# LOCAL_SPARK_TWILIO_API_SECRET=...
# Enable test only after configuring your own sandbox. Never commit real secrets.
# LOCAL_SPARK_STRIPE_SECRET_KEY=sk_test_...
# LOCAL_SPARK_STRIPE_WEBHOOK_SECRET=whsec_...
# LOCAL_SPARK_STRIPE_PRICE_ID=price_...
# LOCAL_SPARK_BILLING_MONTHLY_AMOUNT_MINOR=9900
# Production also requires BILLING_LIVE_ENABLED=true and a sk_live_ key.

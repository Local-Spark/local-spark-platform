MEU_BRACO_DIREITO_ENVIRONMENT=development
MEU_BRACO_DIREITO_DATABASE_URL=postgresql+asyncpg://meu_braco_direito_runtime:meu-braco-direito-app-password@localhost:55432/meu_braco_direito_platform
MEU_BRACO_DIREITO_RELAY_DATABASE_URL=postgresql+asyncpg://meu_braco_direito_delivery:meu-braco-direito-relay-password@localhost:55432/meu_braco_direito_platform
MEU_BRACO_DIREITO_MIGRATION_DATABASE_URL=postgresql+asyncpg://postgres:meu-braco-direito-admin-password@localhost:55432/meu_braco_direito_platform
MEU_BRACO_DIREITO_JWT_SECRET=development-meu-braco-direito-change-this-secret-before-deploying
MEU_BRACO_DIREITO_JWT_ISSUER=meu-braco-direito-local
MEU_BRACO_DIREITO_JWT_AUDIENCE=meu-braco-direito-api
MEU_BRACO_DIREITO_TEMPORAL_ADDRESS=localhost:7233
MEU_BRACO_DIREITO_TEMPORAL_NAMESPACE=default
MEU_BRACO_DIREITO_TEMPORAL_TASK_QUEUE=meu-braco-direito-foundation

MEU_BRACO_DIREITO_AUTH_DATABASE_URL=postgresql+asyncpg://meu_braco_direito_identity:meu-braco-direito-auth-password@localhost:55432/meu_braco_direito_platform
MEU_BRACO_DIREITO_PUBLIC_WEB_URL=http://localhost:5173
MEU_BRACO_DIREITO_AUTH_ENCRYPTION_KEY=MDAwMDAwMDAwMDAwMDAwMDAwMDAwMDAwMDAwMDAwMDA=
MEU_BRACO_DIREITO_SMTP_HOST=localhost
MEU_BRACO_DIREITO_SMTP_PORT=11025
MEU_BRACO_DIREITO_BILLING_DATABASE_URL=postgresql+asyncpg://meu_braco_direito_payments:meu-braco-direito-billing-password@localhost:55432/meu_braco_direito_platform
MEU_BRACO_DIREITO_BILLING_MODE=disabled
MEU_BRACO_DIREITO_PHONE_VERIFY_MODE=disabled
MEU_BRACO_DIREITO_META_WEBHOOK_MODE=disabled
# To enable F02 ingestion, provision the isolated meu_braco_direito_ingest login and set:
# MEU_BRACO_DIREITO_META_DATABASE_URL=postgresql+asyncpg://meu_braco_direito_ingest:meu-braco-direito-meta-password@localhost:55432/meu_braco_direito_platform
# MEU_BRACO_DIREITO_CORRELATOR_DATABASE_URL=postgresql+asyncpg://meu_braco_direito_router:meu-braco-direito-router-password@localhost:55432/meu_braco_direito_platform
# MEU_BRACO_DIREITO_META_VERIFY_TOKEN=<random-provider-handshake-token>
# MEU_BRACO_DIREITO_META_APP_SECRET=<Meta-app-secret>
# MEU_BRACO_DIREITO_META_WABA_ID=<your-WABA-id>
# MEU_BRACO_DIREITO_META_PHONE_NUMBER_ID=<your-platform-phone-number-id>
# MEU_BRACO_DIREITO_META_PUBLIC_PHONE=+55<your-platform-number-with-area-code>
# MEU_BRACO_DIREITO_META_ENCRYPTION_KEY=<Fernet-key-from-cryptography>
# MEU_BRACO_DIREITO_META_ACCESS_TOKEN=<Meta-system-user-token-with-whatsapp_business_messaging>
# MEU_BRACO_DIREITO_META_GRAPH_VERSION=vXX.X
# MEU_BRACO_DIREITO_META_REPLY_ENABLED=false
# MEU_BRACO_DIREITO_META_DAILY_MESSAGE_LIMIT=0
# Set a positive per-organization UTC-day attempt cap before explicitly enabling replies.
# The F5 API uses localhost:9000; Docker workers use object-storage:8333 from Compose.
# SeaweedFS/S3 is for local development only. Use a private HTTPS bucket in staging/production.
# MEU_BRACO_DIREITO_MATERIAL_STORAGE_BUCKET=meu-braco-direito-materials
# MEU_BRACO_DIREITO_MATERIAL_STORAGE_ENDPOINT=http://localhost:9000
# MEU_BRACO_DIREITO_MATERIAL_STORAGE_PUBLIC_ENDPOINT=http://localhost:9000
# MEU_BRACO_DIREITO_MATERIAL_STORAGE_ACCESS_KEY=meu-braco-direito-local
# MEU_BRACO_DIREITO_MATERIAL_STORAGE_SECRET_KEY=meu-braco-direito-local-secret
# Paid audio transcription is disabled until both your key and per-tenant daily cap are set.
# MEU_BRACO_DIREITO_AUDIO_TRANSCRIPTION_MODE=openai
# MEU_BRACO_DIREITO_OPENAI_API_KEY=<your-provider-key>
# Optional: only for the explicitly budgeted, synthetic Jev evaluation.
# TYPESAFE_API_KEY=<your-typesafe-key>
# MEU_BRACO_DIREITO_INTENT_AI_MODE=disabled
# Per-business-tenant daily limit in USD millionths; zero disables paid interpretation.
# MEU_BRACO_DIREITO_INTENT_AI_DAILY_BUDGET_USD_MICROS=0
# Image-provider configuration is disabled by default; enabling it does not itself generate a preview.
# MEU_BRACO_DIREITO_VISUAL_AI_MODE=disabled
# Explicit opt-in for the product's visual_ai workflow. Keep disabled until a scoped run is authorized.
# MEU_BRACO_DIREITO_VISUAL_AI_EXECUTION_ENABLED=false
# Conservative reservation per provider attempt, USD millionths; no implicit price or free retry.
# MEU_BRACO_DIREITO_VISUAL_AI_RESERVATION_USD_MICROS=0
# Per-tenant monthly ceiling in USD millionths; zero disables paid visual use.
# MEU_BRACO_DIREITO_VISUAL_AI_MONTHLY_BUDGET_USD_MICROS=0
# Aggregate OpenAI image reservation limit across tenants, USD millionths; zero blocks reservations.
# This is not a provider invoice limit or a cap on calls made outside this ledger.
# MEU_BRACO_DIREITO_VISUAL_AI_GLOBAL_MONTHLY_BUDGET_USD_MICROS=0
# MEU_BRACO_DIREITO_EDITORIAL_AI_MODE=disabled
# MEU_BRACO_DIREITO_EDITORIAL_AI_MODEL=gpt-5-mini
# Somente desenvolvimento/testes; não elimina a necessidade de revisão humana.
# MEU_BRACO_DIREITO_EDITORIAL_CREATIVE_EXPERIMENTAL=false
# MEU_BRACO_DIREITO_EDITORIAL_DAILY_TOKEN_LIMIT=0
# MEU_BRACO_DIREITO_AUDIO_DAILY_SECONDS_LIMIT=600
# Enable only after creating a Twilio Verify Service and API key in your account.
# MEU_BRACO_DIREITO_PHONE_VERIFY_MODE=twilio
# MEU_BRACO_DIREITO_PHONE_VERIFY_CHANNEL=sms
# MEU_BRACO_DIREITO_TWILIO_VERIFY_SERVICE_SID=VA...
# MEU_BRACO_DIREITO_TWILIO_API_KEY=SK...
# MEU_BRACO_DIREITO_TWILIO_API_SECRET=...
# Enable test only after configuring your own sandbox. Never commit real secrets.
# MEU_BRACO_DIREITO_STRIPE_SECRET_KEY=sk_test_...
# MEU_BRACO_DIREITO_STRIPE_WEBHOOK_SECRET=whsec_...
# MEU_BRACO_DIREITO_STRIPE_PRICE_ID=price_...
# MEU_BRACO_DIREITO_BILLING_MONTHLY_AMOUNT_MINOR=9900
# Production also requires BILLING_LIVE_ENABLED=true and a sk_live_ key.

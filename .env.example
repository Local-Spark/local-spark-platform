LOCAL_SPARK_ENVIRONMENT=development
LOCAL_SPARK_DATABASE_URL=postgresql+asyncpg://local_spark_runtime:local-spark-app-password@localhost:55432/local_spark_platform
LOCAL_SPARK_RELAY_DATABASE_URL=postgresql+asyncpg://local_spark_delivery:local-spark-relay-password@localhost:55432/local_spark_platform
LOCAL_SPARK_MIGRATION_DATABASE_URL=postgresql+asyncpg://postgres:local-spark-admin-password@localhost:55432/local_spark_platform
LOCAL_SPARK_JWT_SECRET=development-local-spark-change-this-secret-before-deploying
LOCAL_SPARK_JWT_ISSUER=local-spark-local
LOCAL_SPARK_JWT_AUDIENCE=local-spark-api
LOCAL_SPARK_TEMPORAL_ADDRESS=localhost:7233
LOCAL_SPARK_TEMPORAL_NAMESPACE=default
LOCAL_SPARK_TEMPORAL_TASK_QUEUE=local-spark-foundation

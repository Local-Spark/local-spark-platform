      "status": "format_reference_only"
    },
    {
      "id": "no_message",
      "label": "Dia sem mensagem",
      "message": "Nenhum material novo hoje.",
      "source_media": null,
      "result_media": "assets/coffee-beans.jpg",
      "result_title": "Uma pauta de rotina",
      "result_detail": "Exemplo estático do kit. Na conta real, a pauta depende de acervo autorizado e informações vigentes.",
      "decision": "Usar contexto e acervo existentes; se faltar foto ou fato, pedir ao cliente em vez de inventar.",

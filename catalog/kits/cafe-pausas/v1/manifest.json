  "scenarios": [
    {
      "id": "text_only",
      "label": "Só uma ideia por texto",
      "message": "Quero uma imagem para convidar para uma pausa à tarde. Hoje não tenho foto.",
      "source_media": null,
      "result_media": null,
      "result_title": "Uma pausa para chamar de sua.",
      "result_detail": "Arte tipográfica do kit; sem inventar o salão ou um produto real.",
      "decision": "Se a peça precisar mostrar o café ou um prato específico, pedir uma foto do negócio antes de produzir.",
      "visual_mode": "concept_graphic",
      "status": "demo_of_proposed_flow"
    },
    {
      "id": "product_photo_offer",
      "label": "Foto do produto + promoção",
      "message": "[Foto] Coloque uma oferta para este croissant: R$ 18 hoje.",
      "source_media": "assets/croissant.jpg",
      "result_media": "assets/post-offer-croissant.jpg",
      "result_title": "Croissant da casa · R$ 18",
      "result_detail": "Arte final demonstrativa com foto, preço e CTA incorporados. Foto e oferta são fictícias; no negócio real, preço e prazo exigem confirmação.",
      "decision": "Preservar o prato, a embalagem e o ambiente da foto recebida; confirmar preço e validade antes de sugerir a peça.",
      "visual_mode": "final_photo_offer",
      "status": "demo_of_proposed_flow"
    },
    {
      "id": "venue_photo",
      "label": "Foto do próprio espaço",
      "message": "[Foto do balcão] Faça um convite para conhecer a cafeteria.",
      "source_media": "assets/counter-service.jpg",
      "result_media": "assets/counter-service.jpg",
      "result_title": "Um lugar para fazer uma pausa.",
      "result_detail": "A composição parte da mesma imagem de entrada; esta cafeteria é fictícia.",
      "decision": "Manter o espaço reconhecível. Nunca substituir o salão por um local inventado.",
      "visual_mode": "venue_overlay",
      "status": "demo_of_proposed_flow"
    },
    {
      "id": "voice_note",
      "label": "Áudio + acervo do negócio",
      "message": "[Áudio] Crie uma imagem de um croissant.",
      "source_media": null,
      "result_media": "assets/post-editorial-croissant.jpg",
      "result_title": "Referência visual de croissant",
      "result_detail": "Esta arte fictícia mostra o estilo do kit, não prova montagem no café real. No produto, a IA consultará automaticamente o acervo próprio autorizado do negócio.",
      "decision": "Transcrever, identificar croissant no cardápio e recuperar fotos do produto e do ambiente do mesmo negócio. Se a imagem afirmar mostrar o café real, editar a foto do espaço e conferir fidelidade; sem referências, pedir material ou propor conceito ilustrativo.",
      "visual_mode": "archive_post",
      "status": "demo_of_proposed_flow"
    },
    {
      "id": "short_video",
      "label": "Vídeo curto enviado",
      "message": "[Vídeo] Fiz o preparo do café. Pode virar um reel com legenda?",
      "source_media": null,
      "result_media": "assets/reel-pausas.mp4",
      "result_title": "Referência de formato",
      "result_detail": "O reel do kit é uma sequência fictícia de fotos; não é uma edição do vídeo da mensagem.",
      "decision": "No fluxo real, usar cenas do clipe autorizado, revisar cortes, áudio e legendas antes de pedir aprovação.",
